{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AAQZ Calendar",
  "version": "0.2.0",
  "identifier": "com.aaqz.calendar-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "AAQZ Calendar", "width": 128, "height": 52, "visible": false, "decorations": false, "transparent": true, "shadow": false, "alwaysOnTop": true, "resizable": false, "maximizable": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2OUNCMzc2MkUwQUNEOEUKUldTT3pRb3Vkck9jbHZYUnQ2V1hWMy9hWG8vMkZtT1BPTzdnVDFNcHRPRGtkSFpZZnBMRDZpUE8K",
      "endpoints": ["https://github.com/AzizulAzree/AAQZ/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
