{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AAQZ Calendar",
  "version": "0.1.0",
  "identifier": "com.aaqz.calendar-widget",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "AAQZ Calendar", "width": 128, "height": 52, "visible": false, "decorations": false, "transparent": true, "shadow": false, "alwaysOnTop": true, "resizable": false, "maximizable": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
